generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  email         String @unique
  name          String?
  password      String
  role          Role     @default(MEMBER)
  createAt      DateTime @default(now())
  updateAt      DateTime @updatedAt
}


enum Role {
  ADMIN
  MANAGER
  MEMBER
}